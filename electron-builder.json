{
  "appId": "com.quranvideo.studio",
  "productName": "Quran Video Studio",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**",
    "dist-electron/**"
  ],
  "asar": true,
  "asarUnpack": [
    "**/node_modules/@remotion/compositor-*/**",
    "**/node_modules/@remotion/renderer/**",
    "**/node_modules/better-sqlite3/**"
  ],
  "extraResources": [
    {
      "from": "build/icon.png",
      "to": "icon.png"
    },
    {
      "from": "Quran Scripts",
      "to": "Quran Scripts",
      "filter": ["*.db"]
    },
    {
      "from": "Quran fonts",
      "to": "Quran fonts",
      "filter": ["*.ttf", "*.otf"]
    },
    {
      "from": "compressed_translation_simple",
      "to": "compressed_translation_simple"
    },
    {
      "from": "recitations.json",
      "to": "recitations.json"
    },
    {
      "from": "dist/remotion-bundle",
      "to": "remotion-bundle"
    },
    {
      "from": "node_modules/.remotion",
      "to": ".remotion"
    }
  ],
  "linux": {
    "target": ["tar.gz"],
    "category": "Video",
    "icon": "build/icons"
  },
  "mac": {
    "category": "public.app-category.video",
    "target": ["dmg", "zip"],
    "icon": "build/icon.icns"
  },
  "win": {
    "target": ["nsis", "portable"],
    "icon": "build/icon.ico"
  }
}
